{
  "mcpServers": {
    "worktree": {
      "command": "node",
      "args": [
        "./worktree-mcp/launch.cjs"
      ],
      "cwd": ".",
      "env_vars": [
        "SHW_WORKTREE_ROOT",
        "SHW_WORKTREE_AUTO_PRUNE",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "USERPROFILE",
        "LOCALAPPDATA"
      ]
    }
  }
}
