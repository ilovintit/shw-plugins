{
  "name": "shw-plugins",
  "version": "4.4.0",
  "description": "Spec-driven development workflow with parallel agent execution, TDD/debugging/verification disciplines, DDD architecture spec, and Gitea CI integration.",
  "author": {
    "name": "shw-plugins contributors"
  },
  "license": "MIT",
  "keywords": [
    "spec-driven",
    "workflow",
    "tdd",
    "subagent",
    "parallel"
  ],
  "skills": "skills",
  "commands": "commands",
  "mcpServers": {
    "shw-spec": {
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/mcp-spec/index.js"
      ]
    },
    "gitea": {
      "command": "go",
      "args": [
        "run",
        "gitea.com/gitea/gitea-mcp@v1.6.0"
      ],
      "env": {
        "GITEA_HOST": "${user_config.gitea_host}",
        "GITEA_ACCESS_TOKEN": "${user_config.gitea_token}"
      }
    }
  },
  "userConfig": {
    "gitea_host": {
      "type": "string",
      "default": "https://gitea.songhuwan.com",
      "description": "公司主 Gitea 地址（项目用特殊 Gitea 时见 skill config.md 的项目级配置）"
    },
    "gitea_token": {
      "type": "string",
      "default": "",
      "description": "Gitea API token（Gitea Web → Settings → Applications 创建，scope 按需勾选）"
    }
  }
}
